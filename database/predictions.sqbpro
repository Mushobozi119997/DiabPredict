-- BASE DE DONNÉES : PRÉDICTION DU DIABÈTE
-- ============================================================

-- 1. Table des patients
CREATE TABLE patients (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    pregnancies REAL,
    glucose REAL,
    blood_pressure REAL,
    skin_thickness REAL,
    insulin REAL,
    bmi REAL,
    dpf REAL,
    age REAL,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP
);

-- 2. Table des prédictions
CREATE TABLE predictions (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    patient_id INTEGER,
    prediction INTEGER,
    probability REAL,
    model_used TEXT DEFAULT 'XGBoost',
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (patient_id) REFERENCES patients(id) ON DELETE CASCADE
);

-- 3. Table d'historique
CREATE TABLE history (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    patient_id INTEGER,
    pregnancies REAL,
    glucose REAL,
    blood_pressure REAL,
    skin_thickness REAL,
    insulin REAL,
    bmi REAL,
    dpf REAL,
    age REAL,
    prediction INTEGER,
    probability REAL,
    model_used TEXT DEFAULT 'XGBoost',
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (patient_id) REFERENCES patients(id) ON DELETE CASCADE
);

-- 4. Index
CREATE INDEX idx_predictions_patient ON predictions(patient_id);
CREATE INDEX idx_history_created ON history(created_at DESC);
CREATE INDEX idx_patients_created ON patients(created_at DESC);

-- 5. Vue des prédictions complètes
CREATE VIEW v_predictions_complete AS
SELECT 
    p.id as prediction_id,
    pat.id as patient_id,
    pat.pregnancies,
    pat.glucose,
    pat.blood_pressure,
    pat.skin_thickness,
    pat.insulin,
    pat.bmi,
    pat.dpf,
    pat.age,
    p.prediction,
    p.probability,
    p.model_used,
    p.created_at as prediction_date,
    CASE 
        WHEN p.prediction = 0 THEN 'Non-diabétique'
        ELSE 'Diabétique'
    END as result_label
FROM predictions p
JOIN patients pat ON p.patient_id = pat.id
ORDER BY p.created_at DESC;

-- 6. Vue des statistiques
CREATE VIEW v_statistics AS
SELECT 
    (SELECT COUNT(*) FROM predictions) as total_predictions,
    (SELECT COUNT(*) FROM patients) as total_patients,
    (SELECT COUNT(*) FROM predictions WHERE prediction = 1) as diabetics,
    (SELECT COUNT(*) FROM predictions WHERE prediction = 0) as non_diabetics,
    ROUND((SELECT COUNT(*) FROM predictions WHERE prediction = 1) * 100.0 / 
          NULLIF((SELECT COUNT(*) FROM predictions), 0), 2) as diabetes_rate;

-- 7. Trigger pour sauvegarde automatique
CREATE TRIGGER after_prediction_insert 
AFTER INSERT ON predictions
BEGIN
    INSERT INTO history (
        patient_id, pregnancies, glucose, blood_pressure, skin_thickness,
        insulin, bmi, dpf, age, prediction, probability, model_used
    )
    SELECT 
        p.id, p.pregnancies, p.glucose, p.blood_pressure, p.skin_thickness,
        p.insulin, p.bmi, p.dpf, p.age, 
        NEW.prediction, NEW.probability, NEW.model_used
    FROM patients p
    WHERE p.id = NEW.patient_id;
END;

-- 8. Données de test
INSERT INTO patients (pregnancies, glucose, blood_pressure, skin_thickness, insulin, bmi, dpf, age)
VALUES 
    (2, 120, 70, 25, 80, 28.5, 0.5, 35),
    (1, 85, 65, 20, 60, 25.0, 0.3, 28),
    (5, 150, 80, 30, 120, 35.0, 0.8, 45);

-- 9. Prédictions de test
INSERT INTO predictions (patient_id, prediction, probability)
VALUES 
    (1, 0, 0.25),
    (2, 0, 0.10),
    (3, 1, 0.85);

-- 10. Vérification
SELECT ' Base de données créée avec succès !' as message;
SELECT * FROM v_statistics;</sql><current_tab id="0"/></tab_sql></sqlb_project>
